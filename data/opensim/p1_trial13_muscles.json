    "moment_sign": "OpenSim generalized-force convention: + = ankle dorsiflexion, knee FLEXION (Rajagopal walker knee), hip flexion moment on the child segment",
    "id_moment_boneid": "boneid whole_body_run(trial, p1_params()) right-leg joint_torque_local[:, j, 1] (torque on distal by proximal about the proximal frame's subject-LEFT axis) times [-1, +1, -1] for [ankle, knee, hip]",
    "moment_arm": "OpenSim Muscle.computeMomentArm (= -dL/dq), m; so/dyn_moment = sum_m force_m * moment_arm_m",
    "group": "argmax over crossed joints of mean |moment arm|",
